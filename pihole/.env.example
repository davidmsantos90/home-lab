SERVICE=pihole
SERVICEPORT=8080
TS_AUTHKEY=replace-with-your-reusable-tailscale-auth-key
TZ=Etc/UTC

IMAGE_URL=pihole/pihole:latest
ADMIN_PORT=8080
DNS_SERVER=1.1.1.1

# Base directory for this service's volumes (Tailscale state, Pi-hole/dnsmasq
# config). Defaults to "." (this directory) if unset. Set this to move the
# whole service's persistent data elsewhere, e.g. an external drive.
HOME_LAB_DIR=.
