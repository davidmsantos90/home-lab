# Service Configuration
SERVICE=pihole
IMAGE_URL=pihole/pihole:latest

# Network Configuration
SERVICEPORT=8080

# Time Zone - See: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
TZ=Etc/UTC

# Base directory for this service's volumes (Pi-hole/dnsmasq config).
# Defaults to "." (this directory) if unset. Set this to move the whole
# service's persistent data elsewhere, e.g. an external drive.
HOME_LAB_DIR=.

# Pi-hole PRIMARY/SECONDARY sync (Nebula Sync)
# This instance is the SECONDARY, kept in sync from the Proxmox-hosted
# PRIMARY. Generate an "App Password" on each Pi-hole instance:
# Settings -> Web Interface / API -> App Password. See README.md for the
# full setup and selective-sync policy.
# Use the PRIMARY's LAN URL or private IP on the same trusted network as this
# instance. Replace the placeholder below with your actual host value.
NEBULA_SYNC_PRIMARY_URL=http://<primary-pihole-lan-ip>
NEBULA_SYNC_PRIMARY_PASSWORD=replace-with-primary-app-password
NEBULA_SYNC_SECONDARY_PASSWORD=replace-with-this-instances-app-password
# Cron schedule for the scheduled sync (default: once daily at 05:00).
NEBULA_SYNC_CRON=0 5 * * *
# Optional: set a password at container startup instead of configuring the web
# UI manually after first boot.
# PIHOLE_WEBPASSWORD=replace-with-a-strong-password

