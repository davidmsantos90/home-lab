# Service Configuration
SERVICE=pihole
IMAGE_URL=pihole/pihole:latest

# Network Configuration
SERVICEPORT=8080

# Time Zone - See: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
TZ=Etc/UTC

# Base directory for this service's volumes (Pi-hole/dnsmasq config). Defaults
# to "." (this directory) if unset. Set this to move the whole service's
# persistent data elsewhere, e.g. an external drive.
HOME_LAB_DIR=.
