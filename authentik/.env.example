# Service Configuration
SERVICE=authentik
IMAGE_URL=ghcr.io/goauthentik/server:2025.4.1

# Network Configuration
SERVICEPORT=9000
AUTHENTIK_HTTPS_PORT=9443
AUTHENTIK_HOST=authentik.pimlicoa.duckdns.org
AUTHENTIK_PORT=443
AUTHENTIK_INSECURE=false

# Time Zone - See: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
TZ=Europe/Lisbon

# Base directory for this service's persistent data.
# Defaults to "." (this directory) if unset.
HOME_LAB_DIR=.

AUTHENTIK_DATA_PATH=./authentik-data
AUTHENTIK_POSTGRES_PATH=./postgresql-data
AUTHENTIK_REDIS_PATH=./redis-data
AUTHENTIK_CUSTOM_TEMPLATES_PATH=./custom-templates

# Required secrets - change before first startup.
AUTHENTIK_SECRET_KEY=change-me-to-a-long-random-value
AUTHENTIK_POSTGRES_DB=authentik
AUTHENTIK_POSTGRES_USER=authentik
AUTHENTIK_POSTGRES_PASSWORD=change-me-too

# Optional mail configuration — leave blank if you do not want to enable email delivery.
AUTHENTIK_EMAIL__HOST=
AUTHENTIK_EMAIL__PORT=587
AUTHENTIK_EMAIL__USERNAME=
AUTHENTIK_EMAIL__PASSWORD=
AUTHENTIK_EMAIL__USE_TLS=true
AUTHENTIK_EMAIL__USE_SSL=false
AUTHENTIK_EMAIL__TIMEOUT=10
AUTHENTIK_EMAIL__FROM=authentik@localhost

# Debug / reporting
AUTHENTIK_ERROR_REPORTING__ENABLED=false
