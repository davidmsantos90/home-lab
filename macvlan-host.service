[Unit]
Description=Macvlan host bridge interface
# Allows the host to communicate with containers on the macvlan network (e.g. NPM at 192.168.1.200).
# Required because macvlan containers cannot reach the host's main IP by default.
After=network.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/bash -c '\
  ip link add macvlan-host link eth0 type macvlan mode bridge && \
  ip addr add 192.168.1.201/32 dev macvlan-host && \
  ip link set macvlan-host up && \
  ip route add 192.168.1.200/29 dev macvlan-host'
ExecStop=/bin/bash -c '\
  ip route del 192.168.1.200/29 dev macvlan-host; \
  ip link del macvlan-host'

[Install]
WantedBy=multi-user.target
