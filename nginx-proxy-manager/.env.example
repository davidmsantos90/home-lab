# Service Configuration
SERVICE=nginx-proxy-manager
IMAGE_URL=jc21/nginx-proxy-manager:latest

# LAN IP of your Pi-hole instance, used as this container's primary DNS
# resolver so proxy hosts can use Pi-hole "Local DNS Records" (e.g.
# little-pi4.lan) instead of Docker container names or raw IPs in the
# Forward Hostname/IP field. Defaults to the Pi's own LAN IP (adjust if
# Pi-hole runs elsewhere).
PIHOLE_LAN_IP=192.168.1.60

# Fallback DNS server used only if Pi-hole is unreachable, so external
# lookups (e.g. Let's Encrypt certificate renewal) keep working during a
# Pi-hole outage. Local Pi-hole DNS records still won't resolve during that
# outage, since Pi-hole is their only source of truth.
DNS_FALLBACK=1.1.1.1

# Time Zone - See: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
TZ=Etc/UTC

# Base directory for this service's volumes (NPM data, Let's Encrypt certs).
# Defaults to "." (this directory) if unset. Set this to move the whole
# service's persistent data elsewhere, e.g. an external drive.
HOME_LAB_DIR=.
