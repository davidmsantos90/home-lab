SERVICE=nginx-proxy-manager
TS_AUTHKEY=replace-with-your-reusable-tailscale-auth-key
TZ=Etc/UTC

IMAGE_URL=jc21/nginx-proxy-manager:latest
NPM_IP=192.168.1.5

# Base directory for this service's volumes (Tailscale state, NPM data,
# Let's Encrypt certs). Defaults to "." (this directory) if unset. Set this
# to move the whole service's persistent data elsewhere, e.g. an external drive.
HOME_LAB_DIR=.
