SERVICE=proxmox-backup
SERVICEPORT=8007
TZ=Etc/UTC

# Required for the web UI login. Set a strong password in your local .env file.
PASSWORD=change-me

# Pin to a specific upstream tag for production use. Update this after checking
# the current upstream documentation for the ARM64 image and supported versions.
IMAGE_URL=dockurr/proxmox-backup:latest

# Base directory for this service's persistent data.
# Defaults to "." (this directory) if unset. Keep the config and datastore under
# a dedicated host path so container recreation does not lose the PBS state.
HOME_LAB_DIR=.
