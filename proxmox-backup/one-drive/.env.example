# Copy this file to .env in the same directory and adjust the values for your host.
# This is a project-local config file for non-secret values.
# Keep host-specific secrets, including the notification recipient, in:
# /etc/proxmox-onedrive-backup/notifications.env
# Leave BACKUP_GUESTS empty to back up every Proxmox guest except those listed in EXCLUDED_GUESTS.

TIMEZONE=Europe/Lisbon

RCLONE_CONFIG=/root/.config/rclone/rclone.conf
RCLONE_REMOTE=one-drive-crypt

# Keep REMOTE_PREFIX relative to the configured remote root.
# If the rclone remote is already rooted at one-drive-crypt:/Backups-Proxmox,
# do not repeat that path here or you will end up with Backups-Proxmox/Backups-Proxmox/...
REMOTE_PREFIX=weekly

STAGING_DIR=/var/lib/vz/onedrive-staging
LOG_DIR=/var/log/proxmox-onedrive-backup
LOCK_FILE=/run/proxmox-onedrive-backup.lock

# Optional: notification settings are intentionally in a root-owned system file.
# The script reads /etc/proxmox-onedrive-backup/notifications.env by default.
# Example content: NOTIFY_EMAIL_TO="admin@example.com"
# NOTIFY_SUBJECT_PREFIX="[Proxmox Backup]"
# NOTIFY_CONFIG_FILE="/etc/proxmox-onedrive-backup/notifications.env"

# Option A: back up only the guest IDs you want.
# BACKUP_GUESTS="100 101 102 103"
# EXCLUDED_GUESTS="120"

# Option B: back up everything except the guest IDs you explicitly exclude.
BACKUP_GUESTS=""
EXCLUDED_GUESTS="120"
