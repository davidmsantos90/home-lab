SERVICE=deluge
SERVICEPORT=8112
TS_AUTHKEY=replace-with-your-reusable-tailscale-auth-key
TZ=Etc/UTC

IMAGE_URL=lscr.io/linuxserver/deluge:latest
DELUGE_CONFIG_PATH=./deluge-data/config
DOWNLOADS_PATH=./deluge-data/downloads

# DNS used by the tailscale sidecar for its own external lookups (e.g. Tailscale
# coordination servers, resolving Docker container names is unaffected). Defaults
# to Pi-hole (so local DNS records resolve too); DNS_SERVER_FALLBACK is only used
# if DNS_SERVER is unreachable.
DNS_SERVER=192.168.1.60
DNS_SERVER_FALLBACK=1.1.1.1

# Base directory for this service's config/state volumes (Tailscale state,
# app config). Defaults to "." (this directory) if unset. Set this to move
# the whole service's persistent data elsewhere, e.g. an external drive.
# Does NOT affect DOWNLOADS_PATH — override that separately for your media/download storage.
HOME_LAB_DIR=.
