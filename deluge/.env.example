SERVICE=deluge
SERVICEPORT=8112
DAEMON_PORT=58846
TS_AUTHKEY=replace-with-your-reusable-tailscale-auth-key
TZ=Etc/UTC

IMAGE_URL=lscr.io/linuxserver/deluge:latest

# Base directory for this service's persistent data (Tailscale state, Deluge
# config, and downloads by default). Defaults to "." (this directory) if unset.
# Set this to move the whole service's data elsewhere, e.g. an external drive.
HOME_LAB_DIR=.

# Override to store downloads at a different path than HOME_LAB_DIR (e.g. a
# separate large media volume). Defaults to "${HOME_LAB_DIR}/downloads".
DOWNLOADS_PATH=
