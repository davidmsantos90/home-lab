{
  "name": "@home-lab/app-shell",
  "private": true,
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "@home-lab": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./*": {
      "@home-lab": "./src/*",
      "import": "./dist/*"
    }
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "python3 ./serve.py",
    "serve": "python3 ./serve.py",
    "check": "npm run check:format && npm run check:types && npm run check:lint",
    "check:types": "tsc --noEmit",
    "check:lint": "oxlint",
    "check:format": "prettier --check .",
    "lint": "oxlint --fix",
    "format": "prettier --write ."
  },
  "prettier": "@hitachivantara/uikit-config/prettier",
  "dependencies": {
    "@emotion/css": "^11.10.6",
    "@emotion/react": "^11.10.6",
    "@emotion/styled": "^11.10.6",
    "@hitachivantara/app-shell-shared": "^2.3.5",
    "@hitachivantara/app-shell-vite-plugin": "^2.5.2",
    "@hitachivantara/uikit-react-core": "^6.0.0",
    "@phosphor-icons/react": "^2.1.10",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@hitachivantara/uikit-config": "^0.6.1",
    "@hitachivantara/uikit-uno-preset": "^1.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "oxlint": "^1.9.0",
    "prettier": "^3.1.1",
    "typescript": "^5.5.4",
    "unocss": "^66.4.2",
    "vite": "^7.1.1",
    "vite-plugin-css-injected-by-js": "^4.0.1",
    "vite-tsconfig-paths": "^5.1.4"
  }
}
