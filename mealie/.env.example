# Service Configuration
SERVICE=mealie
IMAGE_URL=ghcr.io/mealie-recipes/mealie:v3.27.0

# Network Configuration
SERVICEPORT=9925
BASE_URL=https://mealie.pimlicoa.duckdns.org

# Create an administrator API token under Profile > API Tokens.
# Used only by update_foods_pt_pt.py; never commit a real token.
API_TOKEN=

# Time Zone - See: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
TZ=Etc/UTC

# Run Mealie as the host user that owns MEALIE_DATA_PATH.
PUID=1000
PGID=1000

# Keep public registration disabled. Administrators can invite additional users.
ALLOW_SIGNUP=false

# Mealie recommends a memory limit to avoid unnecessary Python pre-allocation.
MEMORY_LIMIT=1G

# Base directory for this service's persistent data.
# Defaults to "." (this directory) if unset. Do not place the SQLite database
# on network-attached storage; use Mealie's PostgreSQL deployment instead.
HOME_LAB_DIR=.
MEALIE_DATA_PATH=./mealie-data

# OpenID Connect - Authentik
OIDC_AUTH_ENABLED=false
OIDC_PROVIDER_NAME=Authentik
OIDC_CONFIGURATION_URL=https://authentik.pimlicoa.duckdns.org/application/o/mealie/.well-known/openid-configuration
OIDC_USER_CLAIM=email
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_SIGNUP_ENABLED=true
OIDC_USER_GROUP=mealie-users
OIDC_ADMIN_GROUP=mealie-admins
OIDC_AUTO_REDIRECT=false
OIDC_REMEMBER_ME=true
OIDC_REQUIRES_EMAIL_VERIFICATION=true
