SERVICE=jellyfin
SERVICEPORT=8096
TS_AUTHKEY=replace-with-your-reusable-tailscale-auth-key
TZ=Etc/UTC

IMAGE_URL=lscr.io/linuxserver/jellyfin:latest
JELLYFIN_CONFIG_PATH=./jellyfin-data/config
JELLYFIN_CACHE_PATH=./jellyfin-data/cache
JELLYFIN_MEDIA_PATH=./jellyfin-data/media

# Base directory for this service's config/state volumes (Tailscale state,
# app config/cache). Defaults to "." (this directory) if unset. Set this to
# move the whole service's persistent data elsewhere, e.g. an external drive.
# Does NOT affect JELLYFIN_MEDIA_PATH — override that separately for your media library storage.
HOME_LAB_DIR=.
