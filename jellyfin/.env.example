# Service Configuration
SERVICE=jellyfin
IMAGE_URL=lscr.io/linuxserver/jellyfin:latest

# Network Configuration
SERVICEPORT=8096

# Time Zone
TZ=Europe/Lisbon  # See: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones

# Paths to your Jellyfin data on the host
# Defaults below create local folders — update to point at existing data
JELLYFIN_CONFIG_PATH=./jellyfin-data/config
JELLYFIN_CACHE_PATH=./jellyfin-data/cache
JELLYFIN_MEDIA_PATH=./jellyfin-data/media

# Base directory for this service's persistent data (app config/cache).
# Defaults to "." (this directory) if unset. Set this to move the whole
# service's persistent data elsewhere, e.g. an external drive.
# Does NOT affect JELLYFIN_MEDIA_PATH — override that separately for your media library storage.
HOME_LAB_DIR=.
