SERVICE=immich
SERVICEPORT=2283
TS_AUTHKEY=replace-with-your-reusable-tailscale-auth-key
TZ=Etc/UTC

IMMICH_VERSION=release
UPLOAD_LOCATION=./immich-data/upload

DB_HOSTNAME=database
DB_USERNAME=postgres
DB_PASSWORD=replace-with-strong-db-password
DB_DATABASE_NAME=immich
DB_DATA_LOCATION=./immich-data/postgres

REDIS_HOSTNAME=redis
IMMICH_MACHINE_LEARNING_URL=http://immich-machine-learning:3003
DNS_SERVER=1.1.1.1

# Base directory for this service's config/state volumes (Tailscale state).
# Defaults to "." (this directory) if unset. Set this to move the whole
# service's persistent data elsewhere, e.g. an external drive.
# Does NOT affect UPLOAD_LOCATION — override that separately for your photo/video library storage.
# DB_DATA_LOCATION falls back to HOME_LAB_DIR/postgres-data if unset above.
HOME_LAB_DIR=.
