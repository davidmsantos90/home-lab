# Service Configuration
SERVICE=immich

# Network Configuration
SERVICEPORT=2283

# Time Zone - See: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
TZ=Etc/UTC 

IMMICH_VERSION=release

# Upload storage location
UPLOAD_LOCATION=./immich-data/upload

# Connection settings (match service names in compose.yaml)
REDIS_HOSTNAME=redis
DB_HOSTNAME=database
IMMICH_MACHINE_LEARNING_URL=http://immich-machine-learning:3003

# The location where your database files are stored. Network shares are not supported for the database
DB_DATA_LOCATION=./immich-data/postgres

# Connection secret for postgres. You should change it to a random password
# Please use only the characters `A-Za-z0-9`, without special characters or spaces
DB_PASSWORD=replace-with-strong-db-password

# Base directory for this service's persistent data.
# Defaults to "." (this directory) if unset. Set this to move the whole
# service's persistent data elsewhere, e.g. an external drive.
# Does NOT affect UPLOAD_LOCATION — override that separately for your photo/video library storage.
# DB_DATA_LOCATION falls back to HOME_LAB_DIR/postgres-data if unset above.
HOME_LAB_DIR=.

# The values below this line do not need to be changed
###################################################################################
DB_USERNAME=postgres
DB_DATABASE_NAME=immich
