TZ=Etc/UTC
DUCKDNS_TOKEN=replace-with-your-duckdns-token
TS_AUTHKEY=replace-with-your-reusable-tailscale-auth-key
WG_EASY_HOST=pimlicoa.duckdns.org
WG_EASY_ADMIN_USERNAME=admin
WG_EASY_ADMIN_PASSWORD=replace-with-a-long-unique-password

# RFC-001 Overlap Subnet Configuration
# When VPN clients connect from networks overlapping with HOME_LAN_SUBNET,
# LAN resources are reached through WG_TRANSLATED_LAN_SUBNET (virtual subnet).
# Translation rules map traffic between virtual and real LAN subnets.
HOME_LAN_SUBNET=192.168.1.0/24
WG_TRANSLATED_LAN_SUBNET=10.200.0.0/24
