TZ=Etc/UTC
DUCKDNS_TOKEN=replace-with-your-duckdns-token
WG_EASY_HOST=pimlicoa.duckdns.org
WG_EASY_ADMIN_USERNAME=admin
WG_EASY_ADMIN_PASSWORD=replace-with-a-long-unique-password

# Base directory for this service's volumes (WireGuard config/keys).
# Defaults to "." (this directory) if unset. Set this to move the whole
# service's persistent data elsewhere, e.g. an external drive.
HOME_LAB_DIR=.

# RFC-001 Overlap Subnet Configuration
# When VPN clients connect from networks overlapping with HOME_LAN_SUBNET,
# LAN resources are reached through WG_TRANSLATED_LAN_SUBNET (virtual subnet).
# Translation rules map traffic between virtual and real LAN subnets.
HOME_LAN_SUBNET=192.168.1.0/24
WG_TRANSLATED_LAN_SUBNET=10.200.0.0/24

# WireGuard client defaults managed by bootstrap-hooks.sh
# Comma-separated list; the first entry must be the VPN gateway address
# (WG_TRANSLATED_LAN_SUBNET's .1), NOT Pi-hole directly — DNS queries to the
# gateway get DNAT-redirected to dnsmasq for domain interception, then
# forwarded upstream to Pi-hole. Pointing clients directly at Pi-hole
# bypasses interception entirely.
# Additional entries (e.g. 1.1.1.1) act as a client-side fallback if the
# gateway/dnsmasq/Pi-hole path is ever unreachable — note some OSes/clients
# may race multiple DNS servers rather than strictly failing over, so domain
# rewrites (interception) could occasionally be skipped even when the
# gateway is up but briefly slow to respond.
WG_VPN_DNS=10.200.0.1,1.1.1.1
# Comma-separated CIDRs pushed as default AllowedIPs for new clients.
WG_VPN_ALLOWED_IPS=10.200.0.0/24,192.168.1.0/24
# Seconds between WireGuard keepalive packets sent by the client. Prevents
# NAT/router mappings from expiring during idle periods, which otherwise
# forces a manual VPN reconnect after being idle for a while. 25 is the
# WireGuard-recommended default; set to 0 to disable.
WG_VPN_PERSISTENT_KEEPALIVE=25

# Expose the wg-easy admin UI to connected VPN clients (not the public
# internet) at WG_EASY_ADMIN_TRANSLATED_IP:51821, via a dedicated NAT rule
# mapping it to wg-easy's own pinned homelab-bridge IP. This is still needed
# because wg-easy's admin UI has no presence on the real home LAN at all
# (unlike NPM and other host-bound services, which are already reachable via
# the generic NETMAP subnet translation) — keep these two in sync with the
# "wg-easy" service's pinned ipv4_address in compose.yaml if you ever change
# it.
WG_EASY_ADMIN_HOMELAB_IP=192.168.100.9
WG_EASY_ADMIN_TRANSLATED_IP=10.200.0.9
