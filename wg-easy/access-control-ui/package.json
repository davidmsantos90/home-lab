{
  "name": "access-control-ui",
  "private": true,
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "@home-lab": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./*": {
      "@home-lab": "./src/*",
      "import": "./dist/*"
    }
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "prebuild": "npm run codegen",
    "preview": "vite preview --host 0.0.0.0",
    "check": "npm run check:format && npm run check:types && npm run check:lint",
    "check:types": "tsc --noEmit",
    "check:lint": "oxlint",
    "check:format": "prettier --check .",
    "lint": "oxlint --fix",
    "format": "prettier --write .",
    "test": "vitest",
    "codegen": "openapi-typescript ../access-control/openapi.json -o src/api/openapi-types.ts"
  },
  "prettier": "@hitachivantara/uikit-config/prettier",
  "dependencies": {
    "@emotion/css": "^11.10.6",
    "@emotion/react": "^11.10.6",
    "@emotion/styled": "^11.10.6",
    "@hitachivantara/app-shell-shared": "^2.3.5",
    "@hitachivantara/app-shell-vite-plugin": "^2.5.2",
    "@hitachivantara/uikit-react-core": "^6.0.0",
    "@phosphor-icons/react": "^2.1.10",
    "msw": "^2.15.0",
    "openapi-fetch": "^0.17.0",
    "openapi-typescript": "^7.13.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@hitachivantara/uikit-config": "^0.6.1",
    "@hitachivantara/uikit-uno-preset": "^1.0.0",
    "@testing-library/jest-dom": "^6.1.5",
    "@testing-library/react": "^14.0.0",
    "@testing-library/user-event": "^14.4.3",
    "@types/react": "^18.0.28",
    "@types/react-dom": "^18.0.11",
    "@vitejs/plugin-react": "^5.0.0",
    "@vitest/coverage-v8": "^3.2.4",
    "happy-dom": "^15.11.7",
    "oxlint": "^1.9.0",
    "prettier": "^3.1.1",
    "typescript": "^5.5.4",
    "unocss": "^66.4.2",
    "vite": "^7.1.1",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.2.4"
  }
}
