SERVICE=access-control
SERVICEPORT=8787

# Base directory for this service's persistent data/config.
# Defaults to "." (this directory) if unset. Set this to move the whole
# service's data elsewhere, e.g. an external drive.
HOME_LAB_DIR=.

# Frontend API base URL used when building the UI. Leave unset if the UI is
# served from the same origin as the API (recommended for reverse-proxy setups).
# For local browser testing, use the host/port where the API is actually
# listening, e.g. http://127.0.0.1:8787 or http://<lan-host>:8787.
VITE_ACCESS_CONTROL_API_URL=

# Public path prefix used by the reverse proxy / ingress, typically the path on
# which the UI is exposed (for example /access-control).
ACCESS_CONTROL_PUBLIC_PATH_PREFIX=/access-control

# Additional hosts allowed to make cross-origin requests to the API. This is
# primarily needed when the frontend and API are served from different origins.
# Keep this list small and explicit.
ACCESS_CONTROL_CORS_ALLOWED_HOSTS=localhost,127.0.0.1

WG_EASY_API_URL=http://wg-easy:51821
WG_EASY_ADMIN_USERNAME=admin
WG_EASY_ADMIN_PASSWORD=change-me
