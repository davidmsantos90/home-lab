{
  "openapi": "3.0.3",
  "info": {
    "title": "wg-easy access control API",
    "version": "1.1.0",
    "description": "Discovery, preview, persistence, and apply contract for the RFC-007 access-control UI."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:8787"
    }
  ],
  "paths": {
    "/healthz": {
      "get": {
        "operationId": "getHealthz",
        "responses": {
          "200": {
            "description": "API is healthy",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/api/state": {
      "get": {
        "operationId": "getAccessControlState",
        "responses": {
          "200": {
            "description": "Full access-control snapshot",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccessControlState"
                }
              }
            }
          }
        }
      }
    },
    "/api/config": {
      "get": {
        "operationId": "getAccessControlConfig",
        "responses": {
          "200": {
            "description": "Current aliases and policies document",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccessControlConfigDocument"
                }
              }
            }
          }
        }
      },
      "put": {
        "operationId": "putAccessControlConfig",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AccessControlConfigDraft"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Persisted aliases and policies without applying firewall changes",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccessControlMutationResult"
                }
              }
            }
          }
        }
      }
    },
    "/api/preview": {
      "post": {
        "operationId": "previewAccessControlConfig",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AccessControlConfigDraft"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Preview compiled state for an in-memory draft",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccessControlMutationResult"
                }
              }
            }
          }
        }
      }
    },
    "/api/config/apply": {
      "post": {
        "operationId": "applyAccessControlConfig",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AccessControlConfigDraft"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Persisted aliases and policies and applied compiled firewall rules",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccessControlMutationResult"
                }
              }
            }
          }
        }
      }
    },
    "/api/inventory": {
      "get": {
        "operationId": "getAccessControlInventory",
        "responses": {
          "200": {
            "description": "Peer inventory and alias catalog",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccessControlInventory"
                }
              }
            }
          }
        }
      }
    },
    "/api/aliases": {
      "get": {
        "operationId": "getAccessControlAliases",
        "responses": {
          "200": {
            "description": "Alias catalog",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccessControlAliasesResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/policies": {
      "get": {
        "operationId": "getAccessControlPolicies",
        "responses": {
          "200": {
            "description": "Policy rules",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccessControlPoliciesResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/peers": {
      "get": {
        "operationId": "getAccessControlPeers",
        "responses": {
          "200": {
            "description": "Peer inventory",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/AccessControlPeer"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/peers/{peerName}": {
      "get": {
        "operationId": "getAccessControlPeer",
        "parameters": [
          {
            "name": "peerName",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Peer details",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccessControlPeer"
                }
              }
            }
          }
        }
      }
    },
    "/api/rules": {
      "get": {
        "operationId": "getAccessControlRules",
        "responses": {
          "200": {
            "description": "Policy rules",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/AccessControlRule"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "createAccessControlRule",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AccessControlRule"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Created policy rule",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccessControlRuleItem"
                }
              }
            }
          }
        }
      }
    },
    "/api/rules/{ruleIndex}": {
      "get": {
        "operationId": "getAccessControlRule",
        "parameters": [
          {
            "name": "ruleIndex",
            "in": "path",
            "required": true,
            "schema": { "type": "integer" }
          }
        ],
        "responses": {
          "200": {
            "description": "Policy rule",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccessControlRuleItem"
                }
              }
            }
          }
        }
      },
      "put": {
        "operationId": "replaceAccessControlRule",
        "parameters": [
          {
            "name": "ruleIndex",
            "in": "path",
            "required": true,
            "schema": { "type": "integer" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AccessControlRule"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated policy rule",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccessControlRuleItem"
                }
              }
            }
          }
        }
      },
      "patch": {
        "operationId": "patchAccessControlRule",
        "parameters": [
          {
            "name": "ruleIndex",
            "in": "path",
            "required": true,
            "schema": { "type": "integer" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AccessControlRule"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated policy rule",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccessControlRuleItem"
                }
              }
            }
          }
        }
      },
      "delete": {
        "operationId": "deleteAccessControlRule",
        "parameters": [
          {
            "name": "ruleIndex",
            "in": "path",
            "required": true,
            "schema": { "type": "integer" }
          }
        ],
        "responses": {
          "204": {
            "description": "Policy rule deleted"
          }
        }
      }
    },
    "/api/groups": {
      "get": {
        "operationId": "getAccessControlGroups",
        "responses": {
          "200": {
            "description": "Named peer groups",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/AccessControlGroup"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "createAccessControlGroup",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AccessControlGroup"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Created group",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccessControlGroup"
                }
              }
            }
          }
        }
      }
    },
    "/api/groups/{groupName}": {
      "get": {
        "operationId": "getAccessControlGroup",
        "parameters": [
          {
            "name": "groupName",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Named peer group",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccessControlGroup"
                }
              }
            }
          }
        }
      },
      "put": {
        "operationId": "replaceAccessControlGroup",
        "parameters": [
          {
            "name": "groupName",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AccessControlGroup"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated group",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccessControlGroup"
                }
              }
            }
          }
        }
      },
      "patch": {
        "operationId": "patchAccessControlGroup",
        "parameters": [
          {
            "name": "groupName",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AccessControlGroup"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated group",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccessControlGroup"
                }
              }
            }
          }
        }
      },
      "delete": {
        "operationId": "deleteAccessControlGroup",
        "parameters": [
          {
            "name": "groupName",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "204": {
            "description": "Group deleted"
          }
        }
      }
    },
    "/api/services": {
      "get": {
        "operationId": "getAccessControlServices",
        "responses": {
          "200": {
            "description": "Named service aliases",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/AccessControlService"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "createAccessControlService",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AccessControlService"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Created service",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccessControlService"
                }
              }
            }
          }
        }
      }
    },
    "/api/services/{serviceName}": {
      "get": {
        "operationId": "getAccessControlService",
        "parameters": [
          {
            "name": "serviceName",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Named service alias",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccessControlService"
                }
              }
            }
          }
        }
      },
      "put": {
        "operationId": "replaceAccessControlService",
        "parameters": [
          {
            "name": "serviceName",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AccessControlService"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated service",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccessControlService"
                }
              }
            }
          }
        }
      },
      "patch": {
        "operationId": "patchAccessControlService",
        "parameters": [
          {
            "name": "serviceName",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AccessControlService"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated service",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccessControlService"
                }
              }
            }
          }
        }
      },
      "delete": {
        "operationId": "deleteAccessControlService",
        "parameters": [
          {
            "name": "serviceName",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "204": {
            "description": "Service deleted"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AccessControlPeer": {
        "type": "object",
        "required": ["name", "ipv4Address", "raw"],
        "properties": {
          "name": { "type": "string" },
          "ipv4Address": { "type": "string" },
          "raw": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "additionalProperties": false
      },
      "AccessControlServiceEntry": {
        "type": "object",
        "required": ["protocol", "port"],
        "properties": {
          "protocol": {
            "type": "string",
            "enum": ["tcp", "udp"]
          },
          "port": { "type": "integer" }
        },
        "additionalProperties": true
      },
      "AccessControlAliasCatalog": {
        "type": "object",
        "required": ["groups", "hosts", "services"],
        "properties": {
          "groups": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": { "type": "string" }
            }
          },
          "hosts": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": { "type": "string" }
            }
          },
          "services": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "$ref": "#/components/schemas/AccessControlServiceEntry"
              }
            }
          }
        },
        "additionalProperties": false
      },
      "AccessControlRule": {
        "type": "object",
        "required": ["action"],
        "properties": {
          "source": {
            "type": "array",
            "items": { "type": "string" }
          },
          "destination": {
            "type": "array",
            "items": { "type": "string" }
          },
          "service": {
            "type": "array",
            "items": { "type": "string" }
          },
          "protocol": {
            "type": "string",
            "enum": ["tcp", "udp"]
          },
          "port": { "type": "integer" },
          "action": {
            "type": "string",
            "enum": ["allow", "deny", "drop", "reject"]
          },
          "comment": { "type": "string" }
        },
        "additionalProperties": true
      },
      "AccessControlCompiledState": {
        "type": "object",
        "required": ["iptables", "ipsets"],
        "properties": {
          "iptables": {
            "type": "array",
            "items": {
              "type": "array",
              "items": { "type": "string" }
            }
          },
          "ipsets": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["name", "members"],
              "properties": {
                "name": { "type": "string" },
                "members": {
                  "type": "array",
                  "items": { "type": "string" }
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      },
      "AccessControlInventory": {
        "type": "object",
        "required": ["backend", "policyPath", "aliasesPath", "peers", "aliases"],
        "properties": {
          "backend": { "type": "string" },
          "policyPath": { "type": "string" },
          "aliasesPath": { "type": "string" },
          "peers": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/AccessControlPeer" }
          },
          "aliases": {
            "$ref": "#/components/schemas/AccessControlAliasCatalog"
          }
        },
        "additionalProperties": false
      },
      "AccessControlState": {
        "allOf": [
          { "$ref": "#/components/schemas/AccessControlInventory" },
          {
            "type": "object",
            "required": ["peerMap", "rules", "compiled"],
            "properties": {
              "peerMap": {
                "type": "object",
                "additionalProperties": { "type": "string" }
              },
              "rules": {
                "type": "array",
                "items": { "$ref": "#/components/schemas/AccessControlRule" }
              },
              "compiled": {
                "$ref": "#/components/schemas/AccessControlCompiledState"
              }
            },
            "additionalProperties": false
          }
        ]
      },
      "AccessControlConfigDraft": {
        "type": "object",
        "required": ["aliases", "rules"],
        "properties": {
          "aliases": {
            "$ref": "#/components/schemas/AccessControlAliasCatalog"
          },
          "rules": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/AccessControlRule" }
          }
        },
        "additionalProperties": false
      },
      "AccessControlConfigDocument": {
        "allOf": [
          { "$ref": "#/components/schemas/AccessControlConfigDraft" },
          {
            "type": "object",
            "required": ["policyPath", "aliasesPath"],
            "properties": {
              "policyPath": { "type": "string" },
              "aliasesPath": { "type": "string" }
            },
            "additionalProperties": false
          }
        ]
      },
      "AccessControlMutationResult": {
        "type": "object",
        "required": ["state", "persisted", "applied"],
        "properties": {
          "state": {
            "$ref": "#/components/schemas/AccessControlState"
          },
          "persisted": {
            "type": "boolean"
          },
          "applied": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      },
      "AccessControlAliasesResponse": {
        "type": "object",
        "required": ["aliases"],
        "properties": {
          "aliases": { "$ref": "#/components/schemas/AccessControlAliasCatalog" }
        },
        "additionalProperties": false
      },
      "AccessControlPeersResponse": {
        "type": "object",
        "required": ["peers"],
        "properties": {
          "peers": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/AccessControlPeer" }
          }
        },
        "additionalProperties": false
      },
      "AccessControlGroup": {
        "type": "object",
        "required": ["name", "members"],
        "properties": {
          "name": { "type": "string" },
          "members": {
            "type": "array",
            "items": { "type": "string" }
          }
        },
        "additionalProperties": false
      },
      "AccessControlGroupsResponse": {
        "type": "object",
        "required": ["groups"],
        "properties": {
          "groups": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/AccessControlGroup" }
          }
        },
        "additionalProperties": false
      },
      "AccessControlService": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": { "type": "string" },
          "protocol": {
            "type": "string",
            "enum": ["tcp", "udp"]
          },
          "port": { "type": "integer" },
          "entries": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/AccessControlServiceEntry" }
          }
        },
        "additionalProperties": true
      },
      "AccessControlServicesResponse": {
        "type": "object",
        "required": ["services"],
        "properties": {
          "services": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/AccessControlService" }
          }
        },
        "additionalProperties": false
      },
      "AccessControlRuleItem": {
        "type": "object",
        "required": ["index", "rule"],
        "properties": {
          "index": { "type": "integer" },
          "rule": { "$ref": "#/components/schemas/AccessControlRule" }
        },
        "additionalProperties": false
      },
      "AccessControlRulesResponse": {
        "type": "object",
        "required": ["rules"],
        "properties": {
          "rules": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/AccessControlRule" }
          }
        },
        "additionalProperties": false
      },
      "AccessControlPoliciesResponse": {
        "type": "object",
        "required": ["rules"],
        "properties": {
          "rules": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/AccessControlRule" }
          }
        },
        "additionalProperties": false
      }
    }
  }
}
