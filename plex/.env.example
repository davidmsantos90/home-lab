SERVICE=plex
SERVICEPORT=32400
TZ=Etc/UTC

IMAGE_URL=lscr.io/linuxserver/plex:latest
PLEX_CLAIM=claim-xxxxxxxxxxxxxxxxxxxx

# Base directory for this service's persistent data (Plex config). Defaults to
# "." (this directory) if unset. Set this to move the whole service's data
# elsewhere, e.g. an external drive.
HOME_LAB_DIR=.

# Override to store media at a different path than HOME_LAB_DIR (e.g. a
# separate large media volume). Defaults to "${HOME_LAB_DIR}/media" if unset —
# you'll almost always want to set this to your real media library location.
PLEX_MEDIA_PATH=

# Max CPU cores Plex's application container may use (e.g. "2.0" = 2 cores).
# Prevents library scans/analysis/transcoding from starving other services
# (e.g. NPM) on hosts with limited cores. Defaults to 2.0 if unset.
PLEX_CPU_LIMIT=2.0
