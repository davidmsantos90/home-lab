# Service Configuration
SERVICE=portainer
IMAGE_URL=portainer/portainer-ce:latest

# Network Configuration
SERVICEPORT=9000

# DNS used by the tailscale sidecar for its own external lookups (e.g. Tailscale
# coordination servers, resolving Docker container names is unaffected). Defaults
# to Pi-hole (so local DNS records resolve too); DNS_SERVER_FALLBACK is only used
# if DNS_SERVER is unreachable.
DNS_SERVER=192.168.1.60
DNS_SERVER_FALLBACK=1.1.1.1

# Tailscale Configuration
TS_AUTHKEY=replace-with-your-reusable-tailscale-auth-key

# Time Zone - See: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
TZ=Etc/UTC

# Base directory for this service's volumes (Tailscale state, Portainer data).
# Defaults to "." (this directory) if unset. Set this to move the whole
# service's persistent data elsewhere, e.g. an external drive.
HOME_LAB_DIR=.
